---
// Temporary Phase 1 comparison. Remove this route before production publication.
import '@fontsource-variable/newsreader/standard.css';
import '@fontsource-variable/source-serif-4/standard.css';
import '@fontsource-variable/literata/standard.css';
import '@fontsource/spectral/400.css';
import '@fontsource-variable/source-sans-3/wght.css';
import '../../../styles/specimen.css';

const englishCandidates = [
  { name: 'Newsreader', family: 'Newsreader Variable' },
  { name: 'Source Serif 4', family: 'Source Serif 4 Variable' },
  { name: 'Literata', family: 'Literata Variable' },
  { name: 'Spectral', family: 'Spectral' },
] as const;

const chineseCandidates = [
  { name: 'LXGW WenKai', family: 'LXGW WenKai' },
  { name: 'LXGW WenKai Screen', family: 'LXGW WenKai Screen' },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Typography specimen — Carambi local prototype</title>
  </head>
  <body>
    <main class="specimen-page">
      <header class="page-header">
        <p class="page-kicker">Carambi / temporary specimen</p>
        <h1>Editorial typography comparison</h1>
        <p>Identical content and metrics within each language group. Family changes only.</p>
      </header>

      <section class="language-section english-section" aria-labelledby="english-heading">
        <div class="section-header">
          <h2 id="english-heading">English editorial serif</h2>
          <p>Interface: Source Sans 3</p>
        </div>
        <div class="specimen-grid">
          {englishCandidates.map((candidate) => (
            <article class="specimen specimen-en" style={`--editorial-font: '${candidate.family}'`} lang="en">
              <div class="specimen-heading">
                <h3>{candidate.name}</h3>
                <p class="technical-line">{candidate.name} · 400 · hero 36 px · line-height 1.12</p>
              </div>

              <div class="sample-hero editorial">
                <p class="hero-title">
                  <span>Guides and reference projects</span>
                  <span>for furry visual novels</span>
                  <span>and related games.</span>
                </p>
                <p class="hero-support">Independent documentation and long-term reference work.</p>
              </div>

              <div class="guide-sample">
                <p class="section-label">Selected Guides</p>
                <div class="guide-row">
                  <span class="guide-number">01</span>
                  <div class="guide-main">
                    <p class="guide-title editorial">Demons Within</p>
                    <p class="guide-description">Bilingual player guide</p>
                  </div>
                  <div class="guide-meta">
                    <p>Public 14.6</p>
                    <p>中文 · English</p>
                  </div>
                </div>
              </div>

              <div class="about-sample editorial">
                <h4>About</h4>
                <p>Carambi is the name I use for English-language projects. Also known as 杨桃蜜饯 in Chinese-speaking communities.</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="language-section chinese-section" aria-labelledby="chinese-heading">
        <div class="section-header">
          <h2 id="chinese-heading">Chinese editorial font</h2>
          <p>Interface: PingFang SC / system sans</p>
        </div>
        <div class="specimen-grid">
          {chineseCandidates.map((candidate) => (
            <article class="specimen specimen-zh" style={`--editorial-font: '${candidate.family}'`} lang="zh-CN">
              <div class="specimen-heading">
                <h3>{candidate.name}</h3>
                <p class="technical-line">{candidate.name} · 400 · hero 36 px · line-height 1.12</p>
              </div>

              <div class="sample-hero editorial">
                <p class="hero-title">
                  <span>为兽人视觉小说及相关游戏整理的</span>
                  <span>攻略与参考项目</span>
                </p>
                <p class="hero-support">独立维护的文档与长期参考资料。</p>
              </div>

              <div class="guide-sample">
                <p class="section-label">精选攻略</p>
                <div class="guide-row">
                  <span class="guide-number">01</span>
                  <div class="guide-main">
                    <p class="guide-title editorial">Demons Within</p>
                    <p class="guide-description">双语玩家攻略</p>
                  </div>
                  <div class="guide-meta">
                    <p>Public 14.6</p>
                    <p>中文 · English</p>
                  </div>
                </div>
              </div>

              <div class="about-sample editorial">
                <h4>关于</h4>
                <p>Carambi 是我在英文项目中使用的名字；在中文社区中也使用“杨桃蜜饯 / 杨桃”。</p>
              </div>
            </article>
          ))}
        </div>
      </section>
    </main>
  </body>
</html>
